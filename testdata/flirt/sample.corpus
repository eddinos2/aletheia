# Aletheia open FLIRT-style sample corpus (text interchange, not IDA .sig).
# Lines: CRC-32 (IEEE, poly 0xEDB88320) of first 32 bytes TAB name
#    or: whitespace-separated hex bytes (?? = wildcard) TAB name
#
# Patterns below are illustrative x86-64 / AArch64 prologues for matcher tests.

# Classic x86-64 frame: push rbp; mov rbp, rsp
55 48 89 e5	x64_frame_setup

# AArch64: stp x29, x30, [sp, #-16]!; mov x29, sp  (common frame)
fd 7b bf a9 fd 03 00 91	a64_frame_setup

# AArch64: ret
c0 03 5f d6	a64_ret

# x86-64: ret
c3	x64_ret

# Placeholder CRC (will not match unless a function prefix hashes equal)
00000000	unused_crc_placeholder
